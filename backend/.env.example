APP_ENV=development
ALLOW_PLAINTEXT_MESSAGES=false
DATABASE_URL=sqlite:///./relay.db
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=http://localhost:3000
FIREBASE_PROJECT_ID=your-firebase-project-id
# Local backend: set GOOGLE_APPLICATION_CREDENTIALS to a Firebase service-account JSON path.
# Never commit that JSON file or package it in the mobile app. Prefer workload identity / ADC in production.

# Shared realtime fanout across API instances (blank = local single-process mode)
REDIS_URL=redis://localhost:6379/0
