APP_ENV=development
ALLOW_PLAINTEXT_MESSAGES=false
POSTGRES_PASSWORD=replace-with-a-strong-database-password
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:3000
FIREBASE_PROJECT_ID=your-firebase-project-id
# Local Docker only: path to service account JSON stored OUTSIDE this repository.
FIREBASE_SERVICE_ACCOUNT_FILE=/absolute/path/to/firebase-service-account.json

# Shared realtime fanout across API instances (blank = local single-process mode)
REDIS_URL=redis://localhost:6379/0
